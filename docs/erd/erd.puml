@startuml erd
' Sinh tự động từ backend/prisma/schema.prisma bằng docs/tools/prisma_to_erd.py, không sửa tay
hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F7F5F0
  BorderColor #1B2A41
}

entity "users" as User {
  * id : integer <<PK>>
  --
  * email : varchar <<UQ>>
  * password_hash : varchar
  * full_name : varchar
  * role : Role <<enum>>
    member_type : MemberType <<enum>>
    member_code : varchar <<UQ>>
  * is_active : boolean
  * created_at : timestamp
  * email_reminders : boolean
  * must_change_password : boolean
    password_changed_at : timestamp
    sessions_revoked_at : timestamp
    last_login_at : timestamp
    previous_login_at : timestamp
}

entity "loan_policies" as LoanPolicy {
  * id : integer <<PK>>
  --
  * member_type : MemberType <<UQ,enum>>
  * max_books : integer
  * loan_days : integer
  * renew_limit : integer
  * renew_extra_days : integer
  * fine_per_day : integer
}

entity "authors" as Author {
  * id : integer <<PK>>
  --
  * name : varchar
}

entity "categories" as Category {
  * id : integer <<PK>>
  --
  * name : varchar <<UQ>>
  * slug : varchar <<UQ>>
}

entity "books" as Book {
  * id : integer <<PK>>
  --
    isbn : varchar <<UQ>>
  * title : varchar
    description : varchar
    publisher : varchar
    published_year : integer
  * price : integer
    cover_url : varchar
    goodbooks_id : integer <<UQ>>
  * category_id : integer <<FK>>
  * created_at : timestamp
}

entity "book_authors" as BookAuthor {
  * book_id : integer <<PK>>
  * author_id : integer <<PK>>
  --
}

entity "book_copies" as BookCopy {
  * id : integer <<PK>>
  --
  * book_id : integer <<FK>>
  * barcode : varchar <<UQ>>
  * status : CopyStatus <<enum>>
    shelf_location : varchar
}

entity "loans" as Loan {
  * id : integer <<PK>>
  --
  * copy_id : integer <<FK>>
  * user_id : integer <<FK>>
  * created_by : integer <<FK>>
  * borrowed_at : timestamp
  * due_at : timestamp
    returned_at : timestamp
  * renewed_count : integer
  * status : LoanStatus <<enum>>
    predicted_overdue_risk : double
}

entity "fines" as Fine {
  * id : integer <<PK>>
  --
  * loan_id : integer <<FK>>
  * type : FineType <<enum>>
  * amount : integer
    paid_at : timestamp
    paid_to : integer <<FK>>
  * created_at : timestamp
}

entity "ratings" as Rating {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * book_id : integer <<FK>>
  * score : integer
  * created_at : timestamp
  .. UNIQUE(userId, bookId) ..
}

entity "reservations" as Reservation {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * book_id : integer <<FK>>
    copy_id : integer <<FK>>
  * status : ReservationStatus <<enum>>
  * created_at : timestamp
    ready_at : timestamp
    expires_at : timestamp
}

entity "notifications" as Notification {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * type : varchar
  * title : varchar
  * body : varchar
    link : varchar
    dedupe_key : varchar <<UQ>>
    read_at : timestamp
  * created_at : timestamp
}

entity "password_reset_tokens" as PasswordResetToken {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * token_hash : varchar <<UQ>>
  * expires_at : timestamp
    used_at : timestamp
  * created_at : timestamp
}

entity "reminder_emails" as ReminderEmail {
  * id : integer <<PK>>
  --
  * loan_id : integer
  * user_id : integer <<FK>>
  * kind : varchar
  * status : ReminderEmailStatus <<enum>>
  * attempts : integer
    claimed_at : timestamp
    sent_at : timestamp
    last_error : varchar
  * created_at : timestamp
  .. UNIQUE(loanId, kind) ..
}

entity "payments" as Payment {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK>>
  * txn_ref : varchar <<UQ>>
  * amount : integer
  * status : PaymentStatus <<enum>>
    vnp_transaction_no : varchar
    bank_code : varchar
    response_code : varchar
    note : varchar
  * created_at : timestamp
    paid_at : timestamp
  * expires_at : timestamp
}

entity "payment_fines" as PaymentFine {
  * payment_id : integer <<PK>>
  * fine_id : integer <<PK>>
  --
  * active : boolean
}

enum Role {
  READER
  LIBRARIAN
  ADMIN
}

enum MemberType {
  STUDENT
  LECTURER
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  LOST
  MAINTENANCE
  HELD
}

enum LoanStatus {
  ACTIVE
  RETURNED
  LOST
}

enum ReservationStatus {
  WAITING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FineType {
  OVERDUE
  LOST
}

enum ReminderEmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

Category ||--o{ Book : categoryId
Book ||--o{ BookAuthor : bookId
Author ||--o{ BookAuthor : authorId
Book ||--o{ BookCopy : bookId
BookCopy ||--o{ Loan : copyId
User ||--o{ Loan : userId
User ||--o{ Loan : createdById
Loan ||--o{ Fine : loanId
User |o--o{ Fine : paidToId
User ||--o{ Rating : userId
Book ||--o{ Rating : bookId
User ||--o{ Reservation : userId
Book ||--o{ Reservation : bookId
BookCopy |o--o{ Reservation : copyId
User ||--o{ Notification : userId
User ||--o{ PasswordResetToken : userId
User ||--o{ ReminderEmail : userId
User ||--o{ Payment : userId
Payment ||--o{ PaymentFine : paymentId
Fine ||--o{ PaymentFine : fineId
@enduml
