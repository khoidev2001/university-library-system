@startuml use-case-staff
' Use Case: nhóm chức năng của thủ thư (Librarian) và quản trị (Admin). Bản tách từ use-case-overview.
left to right direction
skinparam nodesep 6
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F5F0
  BorderColor #1B2A41
  ArrowColor #1B2A41
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #1B2A41
}

actor "Librarian\n(Thủ thư)" as Librarian
actor "Admin\n(Quản trị)" as Admin
actor "AI Service" as AI <<hệ thống>>
actor "Google Books API" as GB <<hệ thống>>

Admin -up-|> Librarian

rectangle "Hệ thống Quản lý Thư viện (ULS): thủ thư và quản trị" {
  package "F2 Quản lý sách" {
    usecase "Quản lý đầu sách" as UC03
    usecase "Quản lý bản sao" as UC04
    usecase "Quản lý tác giả,\nthể loại" as UC20
  }
  package "F4 Mượn, trả (Quầy)" {
    usecase "Cho mượn sách" as UC07
    usecase "Nhận trả sách" as UC08
    usecase "Ghi nhận sách mất" as UC11
    usecase "Ghi nhận thu phạt" as UC12b
    usecase "Dự báo nguy cơ\ntrả trễ" as UC19
    usecase "Quản lý hàng đợi\nđặt trước" as UC27
  }
  package "F3 Quản lý bạn đọc" {
    usecase "Tra cứu & khoá/mở\nthẻ bạn đọc" as UC13
    usecase "Tạo bạn đọc,\ncấp mật khẩu tạm" as UC28
  }
  package "F6 / F15 / F16 Báo cáo, xuất, in, nhập" {
    usecase "Xem báo cáo\nthống kê" as UC16
    usecase "Xuất CSV / Excel" as UC29
    usecase "In thẻ bạn đọc,\nnhãn mã vạch" as UC30
    usecase "Nhập sách từ\nfile CSV / xlsx" as UC31
  }
  package "F3 / F8 Quản trị" {
    usecase "Tạo tài khoản\nthủ thư" as UC14
    usecase "Cấu hình chính\nsách mượn" as UC15
    usecase "Huấn luyện lại\nmô hình AI" as UC21
    usecase "Nhập sách hàng loạt\ntheo ISBN" as UC22
  }
}

Librarian --> UC03
Librarian --> UC04
Librarian --> UC20
Librarian --> UC07
Librarian --> UC08
Librarian --> UC11
Librarian --> UC12b
Librarian --> UC27
Librarian --> UC13
Librarian --> UC28
Librarian --> UC16
Librarian --> UC29
Librarian --> UC30
Librarian --> UC31

Admin --> UC14
Admin --> UC15
Admin --> UC21
Admin --> UC22

UC07 ..> UC19 : <<include>>
UC08 ..> UC12b : <<extend>>\n(khi trả trễ)
UC19 --> AI
UC21 --> AI
UC22 --> GB
@enduml
