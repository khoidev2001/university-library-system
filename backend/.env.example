DATABASE_URL=postgresql://uls:uls@localhost:5432/uls?schema=public
PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost,http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=2000
INTERNAL_API_KEY=change-me-internal
GOOGLE_BOOKS_API_KEY=
# Email qua Resend (HTTP, không dùng SMTP). Bỏ trống RESEND_API_KEY = không gửi thư, không lỗi.
RESEND_API_KEY=
# Người gửi, ví dụ: Thư viện MUCE <no-reply@ten-mien-da-xac-minh.vn> (thử nhanh: onboarding@resend.dev)
MAIL_FROM=
# Địa chỉ công khai của web, dùng dựng liên kết đặt lại mật khẩu (mặc định: mục đầu của CORS_ORIGINS)
APP_PUBLIC_URL=http://localhost:3001

# Thanh toán phạt trực tuyến qua VNPay. Bỏ trống VNPAY_TMN_CODE / VNPAY_HASH_SECRET = tắt thanh toán online
# (nút ẩn, POST /api/payments trả 503 PAYMENT_NOT_CONFIGURED), thu tiền mặt tại quầy vẫn dùng bình thường.
# Đăng ký sandbox và hướng dẫn chi tiết: README mục "Thanh toán phạt trực tuyến (VNPay)".
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# APP_PUBLIC_URL (ở trên) là địa chỉ web công khai (Vercel hoặc gateway), không có dấu / cuối; trang kết quả thanh toán nằm ở ${APP_PUBLIC_URL}/my/payments/result
# Mặc định ${APP_PUBLIC_URL}/api/payments/vnpay/return; chỉ đặt khi muốn VNPay gọi thẳng backend
VNPAY_RETURN_URL=

