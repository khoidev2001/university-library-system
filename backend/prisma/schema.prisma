// ERD — docs/PLAN.md mục 4. Chuẩn 3NF.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm: chỉ mục GIN cho tìm kiếm ILIKE '%…%' (Neon / Render Postgres đều hỗ trợ)
  extensions = [pg_trgm]
}

enum Role {
  READER
  LIBRARIAN
  ADMIN
}

enum MemberType {
  STUDENT
  LECTURER
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  LOST
  MAINTENANCE
  HELD // giữ cho bạn đọc đã đặt trước
}

enum LoanStatus {
  ACTIVE
  RETURNED
  LOST
}

enum ReservationStatus {
  WAITING // đang xếp hàng
  READY // đã có bản sao giữ cho bạn đọc
  FULFILLED // đã mượn
  CANCELLED
  EXPIRED // quá hạn nhận sách
}

enum FineType {
  OVERDUE
  LOST
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  role         Role        @default(READER)
  memberType   MemberType? @map("member_type")
  memberCode   String?     @unique @map("member_code")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  // Tài khoản và email (nhóm tính năng tài khoản): xem khối cuối tệp
  emailReminders     Boolean   @default(true) @map("email_reminders")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  // Phiên (JWT) cấp trước mốc này bị từ chối: đặt khi đặt lại mật khẩu quên / thủ thư cấp lại
  sessionsRevokedAt  DateTime? @map("sessions_revoked_at")
  lastLoginAt        DateTime? @map("last_login_at")
  previousLoginAt    DateTime? @map("previous_login_at")

  passwordResetTokens PasswordResetToken[]
  reminderEmails      ReminderEmail[]

  loans         Loan[]         @relation("LoanReader")
  createdLoans  Loan[]         @relation("LoanCreator")
  ratings       Rating[]
  finesPaid     Fine[]         @relation("FinePaidTo")
  reservations  Reservation[]
  notifications Notification[]

  // Tìm bạn đọc (GET /users?q=) khớp tên, email, mã bằng ILIKE '%…%'
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_full_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([memberCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_member_code_trgm_idx")
  @@map("users")
}

// Chính sách mượn theo loại bạn đọc — Admin sửa qua UI (BR-10: chụp vào phiếu lúc tạo)
model LoanPolicy {
  id             Int        @id @default(autoincrement())
  memberType     MemberType @unique @map("member_type")
  maxBooks       Int        @map("max_books")
  loanDays       Int        @map("loan_days")
  renewLimit     Int        @map("renew_limit")
  renewExtraDays Int        @map("renew_extra_days")
  finePerDay     Int        @map("fine_per_day") // VND

  @@map("loan_policies")
}

model Author {
  id    Int          @id @default(autoincrement())
  name  String
  books BookAuthor[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "authors_name_trgm_idx")
  @@map("authors")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  books Book[]

  @@map("categories")
}

model Book {
  id            Int      @id @default(autoincrement())
  isbn          String?  @unique
  title         String
  description   String?
  publisher     String?
  publishedYear Int?     @map("published_year")
  price         Int      @default(0) // VND, dùng cho phạt mất sách (BR-08)
  coverUrl      String?  @map("cover_url")
  goodbooksId   Int?     @unique @map("goodbooks_id")
  categoryId    Int      @map("category_id")
  createdAt     DateTime @default(now()) @map("created_at")

  category     Category      @relation(fields: [categoryId], references: [id])
  authors      BookAuthor[]
  copies       BookCopy[]
  ratings      Rating[]
  reservations Reservation[]

  // Tìm sách theo tiêu đề / ISBN dạng chứa chuỗi (ILIKE '%…%'); btree trên title không giúp được và chưa từng được dùng
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_title_trgm_idx")
  @@index([isbn(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_isbn_trgm_idx")
  @@index([categoryId])
  @@map("books")
}

// n-n sách ↔ tác giả
model BookAuthor {
  bookId   Int @map("book_id")
  authorId Int @map("author_id")

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

model BookCopy {
  id            Int        @id @default(autoincrement())
  bookId        Int        @map("book_id")
  barcode       String     @unique
  status        CopyStatus @default(AVAILABLE)
  shelfLocation String?    @map("shelf_location")

  book         Book          @relation(fields: [bookId], references: [id])
  loans        Loan[]
  reservations Reservation[]

  @@index([bookId, status])
  @@map("book_copies")
}

model Loan {
  id                   Int        @id @default(autoincrement())
  copyId               Int        @map("copy_id")
  userId               Int        @map("user_id")
  createdById          Int        @map("created_by")
  borrowedAt           DateTime   @default(now()) @map("borrowed_at")
  dueAt                DateTime   @map("due_at")
  returnedAt           DateTime?  @map("returned_at")
  renewedCount         Int        @default(0) @map("renewed_count")
  status               LoanStatus @default(ACTIVE)
  predictedOverdueRisk Float?     @map("predicted_overdue_risk")

  copy      BookCopy @relation(fields: [copyId], references: [id])
  user      User     @relation("LoanReader", fields: [userId], references: [id])
  createdBy User     @relation("LoanCreator", fields: [createdById], references: [id])
  fines     Fine[]

  // "Quá hạn" suy ra: returnedAt IS NULL AND dueAt < now() (BR-09)
  @@index([userId, status])
  @@index([copyId])
  // Quá hạn / nhắc hạn luôn lọc status = ACTIVE rồi so dueAt; thay cho chỉ mục dueAt đơn
  @@index([status, dueAt])
  // Báo cáo theo khoảng ngày mượn (top-books, loans-by-month)
  @@index([borrowedAt])
  @@map("loans")
}

model Fine {
  id        Int       @id @default(autoincrement())
  loanId    Int       @map("loan_id")
  type      FineType
  amount    Int // VND
  paidAt    DateTime? @map("paid_at")
  paidToId  Int?      @map("paid_to")
  createdAt DateTime  @default(now()) @map("created_at")

  loan   Loan  @relation(fields: [loanId], references: [id])
  paidTo User? @relation("FinePaidTo", fields: [paidToId], references: [id])

  @@index([paidAt])
  @@index([loanId])
  @@map("fines")
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bookId    Int      @map("book_id")
  score     Int // 1-5
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("ratings")
}

// Đặt trước sách đang hết bản (FR-RES). READY = bản sao ở trạng thái HELD cho đúng bạn đọc này.
model Reservation {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  bookId    Int               @map("book_id")
  copyId    Int?              @map("copy_id")
  status    ReservationStatus @default(WAITING)
  createdAt DateTime          @default(now()) @map("created_at")
  readyAt   DateTime?         @map("ready_at")
  expiresAt DateTime?         @map("expires_at")

  user User      @relation(fields: [userId], references: [id])
  book Book      @relation(fields: [bookId], references: [id])
  copy BookCopy? @relation(fields: [copyId], references: [id])

  @@index([bookId, status, createdAt])
  @@index([userId, status])
  @@map("reservations")
}

// Thông báo trong web. dedupeKey chống gửi trùng (vd "loan:12:due").
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---- Tài khoản và email ----

// Token đặt lại mật khẩu. Chỉ lưu SHA-256 của token (32 byte ngẫu nhiên), dùng một lần, hạn 1 giờ.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

enum ReminderEmailStatus {
  PENDING // chưa gửi được (lần đầu hoặc đang chờ gửi lại)
  SENT
  FAILED // quá số lần thử, bỏ cuộc
  SKIPPED // không còn cần gửi (đã trả sách, đổi loại nhắc, ...)
}

// Trạng thái email nhắc hạn theo từng phiếu + loại ("due" | "overdue"); duy nhất (loanId, kind)
// nên không bao giờ gửi hai lần cho cùng một phiếu và loại, nhưng gửi lỗi vẫn thử lại được.
model ReminderEmail {
  id        Int                 @id @default(autoincrement())
  loanId    Int                 @map("loan_id")
  userId    Int                 @map("user_id")
  kind      String
  status    ReminderEmailStatus @default(PENDING)
  attempts  Int                 @default(0)
  claimedAt DateTime?           @map("claimed_at") // đang được một tiến trình gửi
  sentAt    DateTime?           @map("sent_at")
  lastError String?             @map("last_error")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([loanId, kind])
  @@index([status, id])
  @@map("reminder_emails")
}
