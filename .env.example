# docker compose
GATEWAY_PORT=8080
POSTGRES_PORT=5434
JWT_SECRET=dev-secret
INTERNAL_API_KEY=dev-internal
GOOGLE_BOOKS_API_KEY=
# Email (tuỳ chọn). Không có RESEND_API_KEY thì bỏ qua mọi việc gửi thư, ứng dụng vẫn chạy bình thường.
# Xem README mục "Tài khoản và email".
RESEND_API_KEY=
MAIL_FROM=
APP_PUBLIC_URL=
# Thanh toán phạt VNPay (bỏ trống = tắt). Đăng ký sandbox: README mục "Thanh toán phạt trực tuyến (VNPay)"
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
